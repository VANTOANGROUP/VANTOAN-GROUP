@app.get('/video/<int:cid>')
def video(cid):
    if cid not in CAMERAS:
        return 'Invalid camera', 404

    def stream():
        last = -1

        while not stop_event.is_set():
            with mutex:
                seq = jpeg_seq[cid]
                jpg = jpeg_cache.get(cid)

            if jpg is not None and seq != last:
                last = seq
                yield (
                    b'--frame\r\n'
                    b'Content-Type: image/jpeg\r\n\r\n'
                    + jpg + b'\r\n'
                )

            stop_event.wait(1/WEB_FPS)

    return Response(
        stream(),
        mimetype=(
            'multipart/x-mixed-replace; boundary=frame'
        )
    )


