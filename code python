def signed_side(point, a, b):
    dx, dy = float(b[0]-a[0]), float(b[1]-a[1])
    length = math.hypot(dx, dy)
    if length < 1: return 0.0
    return (dx*(point[1]-a[1]) - dy*(point[0]-a[0])) / length


def crosses_finite_segment(previous, current, a, b):
    # Intersection of motion segment with finite stop line.
    px, py = previous
    rx, ry = current[0]-px, current[1]-py
    ax, ay = float(a[0]), float(a[1])
    sx, sy = float(b[0]-a[0]), float(b[1]-a[1])
    denom = rx*sy - ry*sx
    if abs(denom) < 1e-6: return False
    qx, qy = ax-px, ay-py
    t = (qx*sy-qy*sx)/denom
    u = (qx*ry-qy*rx)/denom
    return 0 <= t <= 1 and 0 <= u <= 1


