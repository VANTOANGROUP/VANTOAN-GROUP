def pixel_points(points):
    return np.array(
        [[round(p[0]*WIDTH), round(p[1]*HEIGHT)]
         for p in points],
        dtype=np.int32
    )


def point_in_zone(point, points):
    return (
        len(points) >= 3 and
        cv2.pointPolygonTest(
            pixel_points(points), point, False
        ) >= 0
    )


def vehicle_in_parking_zone(box, polygon, mask):
    """Xe nam trong vung neu tam xe o trong vung HOAC giao >= 15% bbox.

    Co the phat hien xe chi cat mot phan vung cam dau, khong can nhan dien banh.
    """
    x1, y1, x2, y2 = [int(v) for v in box]
    x1, y1 = max(0, min(WIDTH, x1)), max(0, min(HEIGHT, y1))
    x2, y2 = max(0, min(WIDTH, x2)), max(0, min(HEIGHT, y2))
    if x2 <= x1 or y2 <= y1:
        return False

    center = ((x1 + x2) / 2.0, (y1 + y2) / 2.0)
    if cv2.pointPolygonTest(polygon, center, False) >= 0:
        return True

    overlap = cv2.countNonZero(mask[y1:y2, x1:x2])
    return overlap / ((x2 - x1) * (y2 - y1)) >= PARK_OVERLAP_THRESHOLD


def distance_to_segment(point, a, b):
    p = np.array(point, dtype=float)
    a = np.array(a, dtype=float)
    b = np.array(b, dtype=float)
    v = b-a
    t = np.clip(
        np.dot(p-a, v) /
        max(float(np.dot(v, v)), 1e-9),
        0, 1
    )
    return float(np.linalg.norm(p-(a+t*v)))


def wheel_on_line(center, line):
    if len(line['points']) != 2:
        return False
    a, b = pixel_points(line['points'])
    return (
        distance_to_segment(center, a, b)
        <= float(line['width']) / 2
    )


def associate_vehicle(center, vehicles):
    px, py = center
    candidates = []
    for i, v in enumerate(vehicles):
        x1, y1, x2, y2 = v['box']
        if (
            x1-10 <= px <= x2+10 and
            y1-10 <= py <= y2+10
        ):
            area = max(1, (x2-x1)*(y2-y1))
            candidates.append((area, i))
    return min(candidates)[1] if candidates else None


def camera_worker(cid):
    while not stop_event.is_set():
        cap = cv2.VideoCapture(cid, cv2.CAP_V4L2)
        cap.set(
            cv2.CAP_PROP_FOURCC,
            cv2.VideoWriter_fourcc(*'MJPG')
        )
        cap.set(cv2.CAP_PROP_FRAME_WIDTH, WIDTH)
        cap.set(cv2.CAP_PROP_FRAME_HEIGHT, HEIGHT)
        cap.set(cv2.CAP_PROP_FPS, CAMERA_FPS)
        cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)

        if not cap.isOpened():
            with mutex:
                status[cid] = 'Disconnected'
            cap.release()
            stop_event.wait(2)
            continue

        with mutex:
            status[cid] = 'Online'

        while not stop_event.is_set():
            ok, frame = cap.read()
            if not ok:
                break

            if (frame.shape[1], frame.shape[0]) != (WIDTH, HEIGHT):
                frame = cv2.resize(frame, (WIDTH, HEIGHT))

            with mutex:
                frames[cid] = frame
                frame_seq[cid] += 1

        cap.release()
        with mutex:
            status[cid] = 'Reconnecting'
        stop_event.wait(1)


def analyze(cid, objects, cfg):
    vehicles = [
        o for o in objects if is_vehicle(o['name'])
    ]
    wheels = [
        o for o in objects if o['name'] in WHEEL_CLASSES
    ]

    zone_counts, line_counts = {}, {}
    hits = []
    hit_vehicles, hit_wheels = set(), set()
    parking_hits = []
    parking_vehicles = set()
    parking_counts = {}

    # Phat hien xe trong vung cam dau, khong can banh xe va khong cho 30 giay.
    for zone in cfg.get('parking_zones', []):
        if zone['camera'] != cid or len(zone['points']) < 3:
            continue
        polygon = pixel_points(zone['points'])
        mask = np.zeros((HEIGHT, WIDTH), dtype=np.uint8)
        cv2.fillPoly(mask, [polygon], 255)
        found = 0
        for vi, vehicle in enumerate(vehicles):
            if not vehicle_in_parking_zone(vehicle['box'], polygon, mask):
                continue
            x1, y1, x2, y2 = vehicle['box']
            center = ((x1+x2)/2.0, (y1+y2)/2.0)
            parking_hits.append({
                'line_id': zone['id'],
                'vehicle_index': vi,
                'wheel_index': None,
                'center': center,
            })
            parking_vehicles.add(vi)
            found += 1
        parking_counts[zone['id']] = found

    for z in cfg['zones']:
        if z['camera'] != cid:
            continue

        zone_counts[z['id']] = sum(
            point_in_zone(
                (
                    (v['box'][0]+v['box'][2])//2,
                    v['box'][3]
                ),
                z['points']
            )
            for v in vehicles
        )

    for line in cfg['lines']:
        if line['camera'] != cid:
            continue

        lv, lw = set(), set()

        if len(line['points']) == 2:
            for wi, wheel in enumerate(wheels):
                x1, y1, x2, y2 = wheel['box']
                center = (
                    (x1+x2)//2,
                    (y1+y2)//2
                )

                if not wheel_on_line(center, line):
                    continue

                vi = associate_vehicle(center, vehicles)

                hits.append({
                    'line_id': line['id'],
                    'wheel_index': wi,
                    'vehicle_index': vi,
                    'center': center
                })

                lw.add(wi)
                hit_wheels.add(wi)

                if vi is not None:
                    lv.add(vi)
                    hit_vehicles.add(vi)

        line_counts[line['id']] = {
            'wheels': len(lw),
            'vehicles': len(lv)
        }

    return dict(
        vehicles=vehicles,
        wheels=wheels,
        zones=zone_counts,
        lines=line_counts,
        hits=hits,
        hit_vehicles=hit_vehicles,
        hit_wheels=hit_wheels,
        line_alert=bool(hits),
        parking_hits=parking_hits,
        parking_vehicles=parking_vehicles,
        parking_counts=parking_counts,
        parking_alert=bool(parking_hits)
    )


