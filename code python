def occupancy_candidate(cid, hit, track_ids, now, event_type="LINE"):
    """Return a new slot or None if this wheel is already in an active event."""
    line_id = hit['line_id']
    center = tuple(hit['center'])
    vi = hit['vehicle_index']
    tid = track_ids.get(vi) if vi is not None else None
    slots = violation_occupancy.setdefault((cid, event_type, line_id), [])
    ttl = PARK_CLEAR_SECONDS if event_type == 'PARKING' else OCCUPANCY_CLEAR_SECONDS
    slots[:] = [slot for slot in slots if now - slot['last_seen'] <= ttl]
    for slot in slots:
        same_track = tid is not None and slot['tid'] == tid
        distance = math.dist(center, slot['center'])
        if event_type == 'PARKING':
            # Han che hai xe gan nhau bi tinh la mot xe.
            # Van chap nhan sai lech track ID neu xe gan nhu dung yen.
            nearby = (distance <= 20 or
                      (distance <= 45 and (tid is None or slot['tid'] is None)))
        else:
            nearby = distance <= OCCUPANCY_MATCH_PX
        if same_track or nearby:
            slot['center'] = center
            slot['last_seen'] = now
            if tid is not None:
                slot['tid'] = tid
            return None
    return {'center': center, 'last_seen': now, 'tid': tid}


