def save_last_green(pair):
    # Store previous phase, NEVER energize a green light directly on restart.
    try:
        tmp=STATE_FILE.with_suffix('.tmp')
        tmp.write_text(json.dumps({'last_green':pair}),encoding='utf-8')
        tmp.replace(STATE_FILE)
    except OSError as exc: print('State persistence error:',exc,flush=True)

def light_command(st): return COMMANDS.get((st['phase'],st['active']),'de')

def lights_snapshot(now=None):
    now=time.monotonic() if now is None else now
    with light_lock:
        st=light_state
        remaining=max(0,math.ceil(st['ends_at']-now))
        colors={}
        for direction,pair in ((1,'NS'),(2,'NS'),(3,'EW'),(4,'EW')):
            color=(st['phase'].lower() if st['active']==pair and st['phase'] in ('GREEN','YELLOW') else 'red')
            # Red countdown = remaining current phase + pending yellow + all-red
            # + estimated opposing green if red has to wait an additional phase.
            if color=='red':
                if st['phase']=='GREEN':
                    red_seconds=remaining+YELLOW_SECONDS+ALL_RED_SECONDS
                elif st['phase']=='YELLOW': red_seconds=remaining+ALL_RED_SECONDS
                else: red_seconds=remaining
                if st['phase']=='ALL_RED' and st['next_phase']!=pair:
                    red_seconds+=st['planned_green'][st['next_phase']]+YELLOW_SECONDS+ALL_RED_SECONDS
                elif st['phase'] in ('GREEN','YELLOW') and st['active']==pair:
                    red_seconds=0
                if st['phase'] in ('GREEN','YELLOW') and st['active']!=pair:
                    pass
                remaining_for_direction=red_seconds
            else: remaining_for_direction=remaining
            colors[str(direction)]={'color':color,'remaining':remaining_for_direction}
        return {'lights':colors,'light_control':{
            'mode':st['mode'],'phase':st['phase'],'active':st['active'],
            'next_phase':st['next_phase'],'remaining':remaining,
            'demand':dict(st['demand']),'planned_green':dict(st['planned_green']),
            'command':light_command(st),'serial':st['serial'],
            'reason':st['reason'],'last_green':st['last_green']}}

def traffic_controller():
    """Stable fixed-at-start green duration; minimum green and fair alternation."""
    while not stop_event.is_set():
        now = time.monotonic()
        with mutex:
            fresh = all(status[c] == 'Online' and c in last_analysis and
                        now - result_time.get(c, -1e9) <= DATA_MAX_AGE
                        for c in CAMERAS)
            counts = {str(i): 0 for i in range(1, 5)}
            if fresh:
                for cid in CAMERAS:
                    for direction, n in last_analysis[cid]['zones'].items():
                        counts[str(direction)] += int(n)
        with light_lock:
            st = light_state
            st['demand'] = counts
            if not fresh:
                if st['mode'] != 'FAILSAFE_ALL_RED':
                    st['phase'], st['active'] = 'ALL_RED', None
                    st['ends_at'] = now + ALL_RED_SECONDS
                st['mode'] = 'FAILSAFE_ALL_RED'
                st['candidate'] = None
                st['reason'] = 'Camera/AI data stale; simulated all red'
            else:
                recovering = st['mode'] != 'FUZZY'
                st['mode'] = 'FUZZY'
                ns, ew = counts['1'] + counts['2'], counts['3'] + counts['4']
                for pair in ('NS', 'EW'):
                    st['planned_green'][pair] = duration_for(pair, counts, now-st['wait_since'][pair])
                if recovering:
                    st['phase'], st['active'] = 'ALL_RED', None
                    st['ends_at'] = now + ALL_RED_SECONDS
                    st['reason'] = 'Recovery safety clearance'
                elif st['phase'] == 'ALL_RED' and now >= st['ends_at']:
                    pair = st['next_phase']
                    st['phase'], st['active'] = 'GREEN', pair
                    st['started_at'] = now
                    duration = max(GREEN_MIN, min(GREEN_MAX, duration_for(pair, counts, now-st['wait_since'][pair])))
                    st['ends_at'] = now + duration
                    st['last_green'] = pair
                    st['wait_since'][pair] = now
                    st['next_phase'] = other(pair)
                    st['candidate'] = None
                    st['reason'] = 'Green phase locked for stable countdown'
                    save_last_green(pair)
                elif st['phase'] == 'YELLOW' and now >= st['ends_at']:
                    st['phase'], st['active'] = 'ALL_RED', None
                    st['ends_at'] = now + ALL_RED_SECONDS
                    st['reason'] = 'Yellow completed; all-red clearance'
                elif st['phase'] == 'GREEN':
                    active = st['active']
                    own, opp = (ns, ew) if active == 'NS' else (ew, ns)
                    elapsed = now-st['started_at']
                    if elapsed >= GREEN_MIN and opp >= own + max(3, int(own*.25)):
                        if st['candidate'] != other(active):
                            st['candidate'] = other(active)
                            st['candidate_since'] = now
                    else:
                        st['candidate'] = None
                    early_switch = (st['candidate'] is not None and
                                    now-st['candidate_since'] >= 2.0)
                    if now >= st['ends_at'] or elapsed >= MAX_CONTINUOUS_GREEN or early_switch:
                        st['phase'] = 'YELLOW'
                        st['ends_at'] = now + YELLOW_SECONDS
                        st['next_phase'] = other(active)
                        st['candidate'] = None
                        st['reason'] = 'Green complete; protected yellow transition'
        stop_event.wait(CONTROL_TICK)


serial_state = {'connected': False, 'last_ack': '', 'last_error': '', 'port': SERIAL_PORT,
                'last_pong': 0, 'last_seen': 0}
serial_lock = threading.RLock()
manual_test = {'command': None, 'until': 0.0}
TEST_COMMANDS = {'ae','se','de','dq','dw'}
ping_requested = threading.Event()

def serial_worker():
    try:
        import serial
    except ImportError:
        with serial_lock:
            serial_state['last_error'] = 'Cai pyserial: pip install pyserial'
        return
    while not stop_event.is_set():
        try:
            with serial.Serial(SERIAL_PORT, SERIAL_BAUD, timeout=.25, write_timeout=.4) as port:
                stop_event.wait(2.5)  # ESP32 reset on opening USB
                port.reset_input_buffer()
                last_ping = 0.0
                while not stop_event.is_set():
                    now = time.monotonic()
                    do_ping = ping_requested.is_set() or now-last_ping >= 2.0
                    if do_ping:
                        ping_requested.clear()
                        port.write(b'PING\n')
                        port.flush()
                        deadline = time.monotonic() + 0.8
                        pong = False
                        while time.monotonic() < deadline:
                            line = port.readline().decode('ascii',errors='replace').strip()
                            if line == 'PONG':
                                pong = True
                                break
                        last_ping = time.monotonic()
                        with serial_lock:
                            serial_state['connected'] = pong
                            if pong:
                                serial_state.update(last_pong=time.time(),last_seen=time.time(),last_error='')
                            else:
                                serial_state['last_error'] = 'ESP32 khong tra loi PING'
                    with serial_lock:
                        test = manual_test['command'] if now < manual_test['until'] else None
                    with light_lock:
                        cmd = test or light_command(light_state)
                    port.write((cmd+'\n').encode('ascii'))
                    port.flush()
                    deadline = time.monotonic()+0.8
                    response = ''
                    while time.monotonic() < deadline:
                        line = port.readline().decode('ascii',errors='replace').strip()
                        if line == 'ACK '+cmd:
                            response = line
                            break
                        if line.startswith('ERR'):
                            response = line
                            break
                    with serial_lock:
                        if response == 'ACK '+cmd:
                            serial_state.update(connected=True,last_ack=response,last_seen=time.time(),last_error='')
                        elif response:
                            serial_state['last_error'] = response
                        elif not serial_state['connected']:
                            serial_state['last_error'] = 'Khong nhan ACK'
                    stop_event.wait(.35)
        except Exception as exc:
            with serial_lock:
                serial_state['connected'] = False
                serial_state['last_error'] = str(exc)
            stop_event.wait(2)

@app.get('/api/esp32/status')
def esp32_status():
    with serial_lock:
        result = dict(serial_state)
    if result['last_seen'] and time.time()-result['last_seen'] > 4:
        result['connected'] = False
    return jsonify(result)

@app.post('/api/esp32/test')
def esp32_test():
    cmd = (request.get_json(silent=True) or {}).get('command')
    if cmd not in TEST_COMMANDS:
        return jsonify(ok=False,error='Invalid test command'),400
    with serial_lock:
        manual_test['command'] = cmd
        manual_test['until'] = time.monotonic()+5.0
    return jsonify(ok=True,command=cmd,seconds=5)

@app.post('/api/esp32/ping')
def esp32_ping():
    ping_requested.set()
    with serial_lock:
        return jsonify(ok=True, message='Da yeu cau PING; kiem tra /api/esp32/status')


