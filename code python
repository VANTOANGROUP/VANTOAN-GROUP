def assign_tracks(cid, vehicles, now):
    active = tracks[cid]
    used = set()
    assigned = {}

    for i, v in enumerate(vehicles):
        x1, y1, x2, y2 = v['box']
        center = (
            (x1+x2)/2,
            (y1+y2)/2
        )

        best, distance = None, TRACK_MAX_DISTANCE

        for tid, tr in active.items():
            if (
                tid in used or
                tr['name'] != v['name'] or
                now-tr['last'] > TRACK_TIMEOUT
            ):
                continue

            d = math.dist(center, tr['center'])
            if d < distance:
                best, distance = tid, d

        if best is None:
            best = next_track_id[cid]
            next_track_id[cid] += 1

        active[best] = {
            'name': v['name'],
            'center': center,
            'last': now
        }

        used.add(best)
        assigned[i] = best

    for tid in list(active):
        if now-active[tid]['last'] > TRACK_TIMEOUT:
            del active[tid]

    return assigned


