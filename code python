def ai_worker():
    try:
        model = YOLO(MODEL_PATH, task='detect')
        print('MODEL READY:', model.names, flush=True)
    except Exception as e:
        
            for cid in CAMERAS:
                status[cid] = 'Model error'
        return

    last_infer = {c: 0 for c in CAMERAS}
    last_frame = {c: -1 for c in CAMERAS}

    while not stop_event.is_set():
        worked = False

        for cid in CAMERAS:
            with mutex:
                f = frames.get(cid)
                seq = frame_seq[cid]
                cfg = json.loads(json.dumps(config))

            if f is None or seq == last_frame[cid]:
                continue

            if time.monotonic()-last_infer[cid] < INFER_INTERVAL:
                continue

            worked = True
            last_frame[cid] = seq
            last_infer[cid] = time.monotonic()
            image = f.copy()

            try:
                pred = model.predict(
                    image,
                    imgsz=IMG_SIZE,
                    conf=CONFIDENCE,
                    verbose=False
                )[0]

                detected = []

                for box in pred.boxes:
                    cls = int(box.cls[0].item())
                    detected.append({
                        'name': str(pred.names[cls]).lower(),
                        'box': list(map(
                            int, box.xyxy[0].tolist()
                        )),
                        'confidence': float(
                            box.conf[0].item()
                        )
                    })

                now = time.monotonic()
                data = analyze(cid, detected, cfg)
                track_ids = assign_tracks(
                    cid, data['vehicles'], now
                )

                annotated = draw_scene(
                    image.copy(), cid, data, cfg
                )

                unique_hits = {}

                    unique_hits[key] = hit

                for hit in unique_hits.values():
                    save_event(
                        cid, hit, data,
                        track_ids, annotated, now
                    )

                check_parking(cid, data, track_ids, cfg, now, annotated)

                # Detect crossing only after associating wheel and vehicle.
                red_hits = detect_red_crossings(cid, data, track_ids, cfg, now)
                for hit in red_hits:
                    save_event(cid, hit, data, track_ids,
                               annotated, now, event_type='RED_LIGHT')

                with mutex:
                    results[cid] = detected
                    result_time[cid] = now
                    result_seq[cid] += 1
                    last_analysis[cid] = data

            except Exception as e:
                print(
                    'YOLO error:', cid, e,
                    flush=True
                )
                stop_event.wait(.2)

        if not worked:
            stop_event.wait(.02)


def render_worker(cid):
    period = 1 / WEB_FPS

    while not stop_event.is_set():
        started = time.monotonic()

        with mutex:
            frame = frames.get(cid)
            data = last_analysis.get(cid)
            stamp = result_time.get(cid, 0)
            cfg = json.loads(json.dumps(config))
            current_status = status[cid]

        if frame is None:
            stop_event.wait(.1)
            continue

        age = started-stamp if stamp else 999

        if age > RESULT_TIMEOUT or data is None:
            data = analyze(cid, [], cfg)

        image = draw_scene(
            frame.copy(), cid, data, cfg
        )

        ok, buf = cv2.imencode(
            '.jpg', image,
            [cv2.IMWRITE_JPEG_QUALITY, JPEG_QUALITY]
        )

        with mutex:
            metrics[cid] = {
                'vehicles': len(data['vehicles']),
                'wheels'king_alert'],
                'parking_counts': data['parking_counts'],
                'zones': data['zones'],
                'lines': data['lines'],
                'status': current_status,
                'ai_age': round(age, 2) if stamp else None
            }

            if ok:
                jpeg_cache[cid] = buf.tobytes()
                jpeg_seq[cid] += 1

        stop_event.wait(
            max(.01, period-(time.monotonic()-started))
        )


