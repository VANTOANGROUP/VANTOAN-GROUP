def triangle(x, a, b, c):
    if a == b and x <= b: return 1.0
    if b == c and x >= b: return 1.0
    if x <= a or x >= c: return 0.0
    return (x-a)/(b-a) if x < b else (c-x)/(c-b)

def fuzzify(value, maximum):
    x = max(0., min(1., float(value)/maximum))
    return [triangle(x,0,0,.5), triangle(x,.15,.5,.85), triangle(x,.5,1,1)]

def fuzzy_green(vehicle_count, waiting_seconds):
    # Mamdani: min implication, max aggregation, centroid defuzzification.
    density, waiting = fuzzify(vehicle_count,30), fuzzify(waiting_seconds,90)
    rules = [[0,0,1],[1,1,2],[2,2,2]]
    numerator = denominator = 0.
    for t in range(GREEN_MIN,GREEN_MAX+1):
        output = [triangle(t,10,10,30),triangle(t,20,35,50),triangle(t,40,60,60)]
        membership = max(min(density[i],waiting[j],output[rules[i][j]])
                         for i in range(3) for j in range(3))
        numerator += t*membership
        denominator += membership
    return max(GREEN_MIN,min(GREEN_MAX,round(numerator/denominator) if denominator else GREEN_MIN))

def other(pair): return 'EW' if pair == 'NS' else 'NS'

def duration_for(pair, counts, wait):
    ns, ew = counts['1']+counts['2'], counts['3']+counts['4']
    if ns == ew: return EQUAL_GREEN
    return fuzzy_green(ns if pair=='NS' else ew, wait)

